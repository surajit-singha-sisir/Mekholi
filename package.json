{
  "name": "mekholi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mekholi — a universal retail POS platform with a plugin architecture.",
  "scripts": {
    "android:build": "node tools/android-build.mjs",
    "build": "tsc --noEmit && vite build",
    "build:schema": "node tools/build-schema.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:boundaries && npm run check:clients && npm run test && npm run validate:migrations && npm run build",
    "check:acl": "node tools/check-db-acl.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:clients": "node tools/check-clients.mjs",
    "contract:check": "node tools/api-contract.mjs --check",
    "contract:pull": "node tools/api-contract.mjs",
    "db:push": "node tools/db-push.mjs",
    "db:reset": "node tools/db-reset.mjs --yes",
    "db:seed": "node tools/db-push.mjs --seed",
    "db:status": "node tools/db-push.mjs --status",
    "dev": "vite",
    "e2e": "node tools/e2e-http.mjs",
    "e2e:android": "node tools/android-e2e.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:android": "node --input-type=module -e \"import('./tools/android-build.mjs').then(async (m) => { const r = await m.testCore(); process.exit(r.code ?? (r.ran ? 0 : 0)); })\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:migrations": "node tools/validate-migrations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.16.10",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "eslint": "^9.12.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.8",
    "vitest": "^4.1.11"
  }
}
